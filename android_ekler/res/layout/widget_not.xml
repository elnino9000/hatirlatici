<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_arka_koyu"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_baslik"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:text="Notlarım"
            android:textColor="#F2F4FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_mic_daire"
            android:padding="9dp"
            android:src="@drawable/widget_mic" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_liste"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/widget_bos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Not yok. Mikrofona dokun ve konuş."
        android:textColor="#8E96B8"
        android:textSize="14sp" />
</LinearLayout>
